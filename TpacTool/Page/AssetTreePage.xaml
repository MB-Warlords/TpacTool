<Page x:Class="TpacTool.AssetTreePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TpacTool"
      xmlns:loc="clr-namespace:TpacTool.Properties"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="180"
      Title="AssetTreePage">

    <Page.Resources>
        <Image x:Key="Icon_Folder" Source="../Properties/Icon_Folder.png"/>
        <HierarchicalDataTemplate DataType="{x:Type local:AssetViewModel}"
                                  ItemsSource="{Binding Children}">

            <!--Display the TopLevelName property in the first level.-->
            <TextBlock Text="{Binding Name}" LineHeight="19">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                <Setter Property="Foreground" Value="DarkRed"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </HierarchicalDataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
        </Grid.Background>
        <TreeView x:Name="AssetTree" Margin="0,0,0,36" ItemsSource="{Binding TreeItemSource}"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}"/>
                                <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}"/>
                                <Separator/>
                                <MenuItem Header="Mark Asset for Deletion" Command="{Binding MarkForDeletionCommand}" IsEnabled="{Binding CanMarkForDeletion}"/>
                                <MenuItem Header="Unmark Deletion" Command="{Binding UnmarkDeletionCommand}" IsEnabled="{Binding CanUnmarkDeletion}"/>
                                <MenuItem Header="Save Pending Deletions" Command="{Binding SavePendingDeletionsCommand}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
        <!--litetreeview:LiteTreeViewControl Margin="0,0,0,36" MyItemsSource="{Binding TreeItemSource}" SelectionChanged="LiteTreeViewControl_SelectionChanged"/-->
        <ToggleButton Content="{StaticResource Icon_Folder}" ToolTip="{x:Static loc:Resources.AssetTree_Grouped_Tooltip}" HorizontalAlignment="Left" Margin="5,0,0,5" VerticalAlignment="Bottom" Height="24" Width="24" IsChecked="{Binding IsPackageMode, Mode=TwoWay}"/>
        <TextBox Height="24" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="34,0,122,5" TextWrapping="Wrap" VerticalAlignment="Bottom" ToolTip="{x:Static loc:Resources.AssetTree_Filter_Tooltip}"/>
        <Button Command="{Binding SavePendingDeletionsCommand}" HorizontalAlignment="Right" Margin="0,0,26,5" VerticalAlignment="Bottom" Width="90" Height="24">
            <TextBlock>
                <Run Text="Save "/>
                <Run Text="{Binding PendingDeletionCount, Mode=OneWay}"/>
            </TextBlock>
        </Button>
        <Button Content="X" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Right" Margin="0,0,5,5" VerticalAlignment="Bottom" Width="16" Height="24" BorderBrush="{x:Null}" Background="{x:Null}" FontSize="16" ToolTip="{x:Static loc:Resources.AssetTree_FilterRemove_Tooltip}"/>
    </Grid>
</Page>
